{
  "name": "@gatelite/design-tokens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./tokens.json": "./tokens.json",
    "./css": "./dist/css-variables.css",
    "./tailwind": "./dist/tailwind-theme.js",
    "./flutter": "./dist/brutal-theme.dart"
  },
  "scripts": {
    "build": "ts-node --esm src/build.ts",
    "dev": "ts-node --esm --watch src/build.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}