{
  "name": "@gatelite/api-client",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./generated": {
      "import": "./dist/generated/index.js",
      "require": "./dist/generated/index.js",
      "types": "./dist/generated/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "openapi-typescript-codegen -i src/openapi.json -o src/generated -c fetch --useOptions --useUnionTypes --exportCore true --exportServices true --exportModels true --exportSchemas true"
  },
  "dependencies": {
    "openapi-fetch": "^0.10.0"
  },
  "devDependencies": {
    "@gatelite/config": "workspace:*",
    "openapi-typescript-codegen": "^0.23.0",
    "typescript": "^5.3.0"
  }
}