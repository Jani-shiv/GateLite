# GateLite Environment Variables
# Copy this file to .env.local and fill in your values

# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://gatelite:gatelite@localhost:5432/gatelite

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# OTP Provider (mock, console, msg91)
OTP_PROVIDER=mock
MSG91_AUTH_KEY=

# Pass Signing Key (for HMAC-signed pass codes)
PASS_SIGNING_KEY=your-pass-signing-key-here

# FCM (Firebase Cloud Messaging)
FCM_SERVICE_ACCOUNT_JSON=

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gatelite-dev
S3_ACCESS_KEY=gatelite
S3_SECRET_KEY=gatelite123
S3_REGION=us-east-1

# Payment Provider (razorpay, cashfree)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS
CORS_ORIGIN=http://localhost:3000

# Sentry (error tracking)
SENTRY_DSN=